<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <RootNamespace>{{NAMESPACE}}</RootNamespace>
    <AssemblyName>{{APP_NAME}}</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <UseWinUI>true</UseWinUI>
    <EnableMsixTooling>true</EnableMsixTooling>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>false</WindowsAppSDKSelfContained>
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
    <StartupObject>{{NAMESPACE}}.Program</StartupObject>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <CsWinRTWindowsMetadata Condition="'$(CsWinRTWindowsMetadata)' == '' and !Exists('$(MSBuildProgramFiles32)\Windows Kits\10\Platforms\UAP\10.0.19041.0\Platform.xml') and Exists('$(MSBuildProgramFiles32)\Windows Kits\10\Platforms\UAP\10.0.26100.0\Platform.xml')">10.0.26100.0</CsWinRTWindowsMetadata>
    <CsWinRTWindowsMetadata Condition="'$(CsWinRTWindowsMetadata)' == '' and !Exists('$(MSBuildProgramFiles32)\Windows Kits\10\Platforms\UAP\10.0.19041.0\Platform.xml') and Exists('$(MSBuildProgramFiles32)\Windows Kits\10\Platforms\UAP\10.0.22621.0\Platform.xml')">10.0.22621.0</CsWinRTWindowsMetadata>
    <PublishAot Condition="'$(Configuration)' == 'Release'">true</PublishAot>
    <CsWinRTAotWarningLevel>2</CsWinRTAotWarningLevel>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Microsoft.Windows.CsWinRT" Version="2.2.*" />
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.7.*" />
  </ItemGroup>
</Project>
