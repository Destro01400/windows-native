<Window x:Class="{{NAMESPACE}}.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="{{APP_NAME}}"
        Width="980"
        Height="640"
        MinWidth="360"
        MinHeight="280"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        Background="{DynamicResource AppBackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="40"
                            ResizeBorderThickness="5"
                            GlassFrameThickness="-1"
                            UseAeroCaptionButtons="False"
                            NonClientFrameEdges="None" />
    </shell:WindowChrome.WindowChrome>

    <Grid x:Name="RootLayout">
        <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Custom Title Bar -->
        <Grid Grid.Row="0" Background="{DynamicResource Surface1Brush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0"
                       x:Name="TitleText"
                       Text="{Binding AppTitle}"
                       Style="{StaticResource CaptionTextStyle}"
                       Foreground="{DynamicResource TextPrimaryBrush}"
                       Margin="16,0,0,0"
                       VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis" />

            <Button x:Name="MinBtn"
                    Grid.Column="2"
                    Click="OnMinimizeClick"
                    Style="{StaticResource CaptionButtonStyle}"
                    ToolTip="Minimize"
                    AutomationProperties.Name="Minimize">
                <TextBlock FontFamily="{StaticResource SymbolFontFamily}"
                           FontSize="10"
                           Text="&#xE921;"
                           IsHitTestVisible="False" />
            </Button>

            <Button x:Name="MaxBtn"
                    Grid.Column="3"
                    Click="OnMaximizeRestoreClick"
                    Style="{StaticResource CaptionButtonStyle}"
                    ToolTip="Maximize"
                    AutomationProperties.Name="Maximize">
                <TextBlock x:Name="MaxGlyph"
                           FontFamily="{StaticResource SymbolFontFamily}"
                           FontSize="10"
                           Text="&#xE922;"
                           IsHitTestVisible="False" />
            </Button>

            <Button x:Name="CloseBtn"
                    Grid.Column="4"
                    Click="OnCloseClick"
                    Style="{StaticResource CaptionCloseButtonStyle}"
                    ToolTip="Close"
                    AutomationProperties.Name="Close">
                <TextBlock FontFamily="{StaticResource SymbolFontFamily}"
                           FontSize="10"
                           Text="&#xE8BB;"
                           IsHitTestVisible="False" />
            </Button>
        </Grid>

        <!-- Content Layer -->
        <Border Grid.Row="1"
                BorderBrush="{DynamicResource DividerBrush}"
                BorderThickness="0,1,0,0"
                Padding="24">
            <Grid MaxWidth="860">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Header -->
                <StackPanel Grid.Row="0" Margin="0,0,0,16">
                    <TextBlock Text="{Binding AppTitle}" Style="{StaticResource TitleTextStyle}" />
                    <TextBlock Text="Native WPF (.NET 10) starter with WindowChrome Snap Layouts, CsWin32, and WCAG-verified tokens."
                               Style="{StaticResource BodyTextStyle}"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               Margin="0,4,0,0" />
                </StackPanel>

                <!-- Action Card -->
                <Border Grid.Row="1"
                        Background="{DynamicResource CardSurfaceBrush}"
                        BorderBrush="{DynamicResource CardStrokeBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="16"
                        Margin="0,0,0,16">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBox Grid.Column="0"
                                     Style="{StaticResource FluentTextBoxStyle}"
                                     Text="{Binding InputText, UpdateSourceTrigger=PropertyChanged}"
                                     AutomationProperties.Name="New item text"
                                     Margin="0,0,8,0" />

                            <Button Grid.Column="1"
                                    Content="Add item"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    Command="{Binding AddItemCommand}"
                                    Margin="0,0,8,0" />

                            <Button Grid.Column="2"
                                    Content="Reset status"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Command="{Binding ClearStatusCommand}" />
                        </Grid>

                        <Border Grid.Row="1"
                                Margin="0,12,0,0"
                                Padding="10,6"
                                CornerRadius="4"
                                Background="{DynamicResource StatusSuccessSoftBrush}">
                            <TextBlock Text="{Binding StatusText}"
                                       Style="{StaticResource CaptionTextStyle}"
                                       Foreground="{DynamicResource StatusSuccessBrush}" />
                        </Border>
                    </Grid>
                </Border>

                <!-- Virtualized Item List -->
                <Border Grid.Row="2"
                        Background="{DynamicResource CardSurfaceBrush}"
                        BorderBrush="{DynamicResource CardStrokeBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="8">
                    <ListBox ItemsSource="{Binding Items}"
                             BorderThickness="0"
                             Background="Transparent"
                             VirtualizingPanel.IsVirtualizing="True"
                             VirtualizingPanel.VirtualizationMode="Recycling"
                             VirtualizingPanel.ScrollUnit="Pixel"
                             ScrollViewer.CanContentScroll="True"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             AutomationProperties.Name="Workspace items">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="8,6">
                                    <TextBlock Text="{Binding}" Style="{StaticResource BodyTextStyle}" />
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
